# ---- Docker (docker compose membaca file .env ini) -------------------------------
# Kosongkan dua baris ini bila memakai Ollama yang diinstal langsung di laptop (disarankan di Mac).
# COMPOSE_PROFILES=ollama
# OLLAMA_URL=http://ollama:11434
# ERP_SESSION_SECRET=ganti-dengan-teks-acak
# Password database: WAJIB diganti sebelum port 5433 dibuka di jaringan (default-nya tertulis di kit).
# Huruf/angka/-/_ saja. Berlaku juga untuk compose kit yang di-include dan untuk Cara 2 (lihat README).
# DB_ADMIN_PASSWORD=ganti-password-admin
# ERP_APP_PASSWORD=ganti-password-aplikasi

# ---- Tanpa Docker (python -m server) -----------------------------------------------
# Model AI (lokal/cloud) diatur di .env milik kit: ../kit/asisten-erp-ai/.env
# ERP_DATABASE_URL=postgresql://erp_app:aplikasi_erp@localhost:5433/erp
# ERP_DATABASE_URL_ADMIN=postgresql://erp_admin:admin_workshop@localhost:5433/erp
# ERP_HOST=127.0.0.1
# ERP_PORT=8080
# ASISTEN_PATH=/path/ke/kit/asisten-erp-ai
# ERP_REKAM=1
