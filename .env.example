# Salin file ini menjadi .env lalu sesuaikan.  JANGAN commit file .env (berisi API key).
#
# Untuk workshop: semua nilai di bawah sudah cocok untuk laptop sendiri (database Docker di localhost:5433,
# Ollama di localhost:11434, ERP di localhost:8080). Yang perlu diisi hanya dua hal:
#   1. Hapus tanda # di blok PROFIL (d) paling bawah, lalu isi LOKAL_API_KEY dengan API key dari mentor.
#   2. Isi RAG_KOLEKSI dengan nama kamu (huruf kecil, mis. budi). Dipakai mulai Tahap 4.
# Periksa hasilnya: python scripts/cek_setup.py

# --- Database (docker compose up -d) -------------------------------------
# Koneksi asisten AI: role read-only (hanya membaca view schema "ai" dan koleksi dokumen)
DATABASE_URL=postgresql://erp_ai_readonly:baca_saja@localhost:5433/erp
# Koneksi ingest dokumen (Tahap 4). Kosong = memakai DATABASE_URL_ADMIN (laptop sendiri).
DATABASE_URL_PESERTA=
DATABASE_URL_ADMIN=postgresql://erp_admin:admin_workshop@localhost:5433/erp
# Koneksi aplikasi ERP (python -m server). Biasanya tidak perlu diubah.
# ERP_DATABASE_URL=postgresql://erp_app:aplikasi_erp@localhost:5433/erp
# ERP_DATABASE_URL_ADMIN=postgresql://erp_admin:admin_workshop@localhost:5433/erp
# ERP_PORT=8080

# --- Model chat ------------------------------------------------------------
# Bawaan: Ollama di laptop sendiri. Untuk workshop dipakai Claude Haiku lewat blok PROFIL (d) di bawah.
LOKAL_BASE_URL=http://localhost:11434/v1
LOKAL_MODEL=qwen3:8b
LOKAL_API_KEY=ollama
# "none" mematikan mode berpikir Qwen3 (jauh lebih cepat). Kosongkan untuk model lain bila error.
LOKAL_REASONING_EFFORT=none
# Temperature. Kosong = tidak dikirim (wajib kosong untuk model Claude).
LOKAL_SUHU=0.2

# --- Embedding untuk RAG (Tahap 4): Ollama di laptop sendiri, `ollama pull bge-m3` -------------
EMBED_MODEL=bge-m3
EMBED_BASE_URL=http://localhost:11434/v1
# Nama koleksi dokumen kamu: huruf kecil, angka, atau garis bawah, diawali huruf (mis. budi).
RAG_KOLEKSI=

# --- ERP (alamat aplikasi ini sendiri) ---------------------------------------
ERP_URL=http://localhost:8080
ERP_PASSWORD=demo123

# --- Model cloud kedua (opsional, tombol Cloud di panel) --------------------
CLOUD_BASE_URL=
CLOUD_MODEL=
CLOUD_API_KEY=
CLOUD_REASONING_EFFORT=
CLOUD_SUHU=

# --- Lain-lain -------------------------------------------------------------
MAKS_LANGKAH=6


# =========================================================================
# PROFIL (d) WORKSHOP — model chat Claude Haiku 5.5 lewat API key dari mentor
# Hapus tanda # di lima baris ini dan isi key-nya. Database, embedding, dan ERP tetap di laptop sendiri.
# - Pertanyaan, hasil query tool, dan potongan dokumen DIKIRIM ke Anthropic. Di sini semuanya data dummy;
#   untuk data klien sungguhan, mode ini butuh persetujuan pemilik data.
# - API key punya batas biaya dan dicabut setelah workshop. Jangan dibagikan, ditempel ke prompt, atau di-commit.
# =========================================================================
# LOKAL_BASE_URL=https://api.anthropic.com/v1/
# LOKAL_MODEL=claude-haiku-5-5
# LOKAL_API_KEY=<API key dari mentor>
# LOKAL_REASONING_EFFORT=
# LOKAL_SUHU=
